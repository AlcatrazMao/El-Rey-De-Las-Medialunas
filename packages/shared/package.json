{
  "name": "@medialunas/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, constants, validators, and utilities for El Rey De Las Medialunas",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./types/models": "./src/types/models.ts",
