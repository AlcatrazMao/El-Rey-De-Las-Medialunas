# ============================================================================
# El Rey De Las Medialunas — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.
#
# ┌─────────────────────────────────────────────────────────────────┐
# │ GITHUB SECRETS (set in Settings > Secrets and variables)        │
# │ These are NEVER in .env — they go to GitHub for CI/CD.         │
# └─────────────────────────────────────────────────────────────────┘

# ─── Cloudflare ────────────────────────────────────────────────────
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Account.Workers Scripts (Edit), 
#   Account.D1 (Edit), Account.R2 (Edit), Account.KV (Edit)
CF_API_TOKEN=your-cloudflare-api-token
# Your Cloudflare Account ID (found in dashboard URL or sidebar)
CF_ACCOUNT_ID=your-cloudflare-account-id

# ─── Firebase ──────────────────────────────────────────────────────
# Service Account JSON from Firebase Console > Project Settings >
#   Service Accounts > Generate new private key
# This is the ENTIRE JSON object as a single-line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Firebase Project ID (from Firebase Console)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── Firebase Web App (VITE_* vars used at BUILD time) ─────────────
# From Firebase Console > Project Settings > General > Your apps > Web app
# These go to BOTH GitHub Secrets AND local .env
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx

# ─── D1 Database (Cloudflare) ──────────────────────────────────────
# From: npx wrangler d1 list
D1_DATABASE_ID=your-d1-database-id

# ─── KV Namespaces ─────────────────────────────────────────────────
# From: npx wrangler kv:namespace list
KV_CACHE_ID=your-kv-cache-id
KV_SESSIONS_ID=your-kv-sessions-id
KV_RATE_LIMIT_ID=your-kv-rate-limit-id

# ═══════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT (below this line: local .env only, NOT GitHub)
# ═══════════════════════════════════════════════════════════════════

# ─── Application ───────────────────────────────────────────────────
APP_NAME=El Rey De Las Medialunas
APP_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:8787

# ─── Firebase (local dev) ──────────────────────────────────────────
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000

# ─── Cloudflare (local dev) ────────────────────────────────────────
# For wrangler dev (uses CF_API_TOKEN from above)
CF_ZONE_ID=your-cloudflare-zone-id

# ─── Queues ────────────────────────────────────────────────────────
QUEUE_INVENTORY_NAME=inventory-processing
QUEUE_REPORTS_NAME=report-generation

# ============================================================================
# GITHUB SECRETS SETUP CHECKLIST
# ============================================================================
# Go to: https://github.com/{owner}/{repo}/settings/secrets/actions
# Add these Repository Secrets:
#
#   ✅ CF_API_TOKEN               Cloudflare API token
#   ✅ CF_ACCOUNT_ID              Cloudflare account ID
#   ✅ FIREBASE_SERVICE_ACCOUNT   Full service account JSON (single line)
#   ✅ FIREBASE_PROJECT_ID        Firebase project ID
#   ✅ FIREBASE_API_KEY           Firebase Web API key
#   ✅ FIREBASE_AUTH_DOMAIN       Firebase auth domain
#   ✅ FIREBASE_APP_ID            Firebase app ID
#   ✅ D1_DATABASE_ID             D1 database UUID
#   ✅ KV_CACHE_ID                KV cache namespace UUID
#   ✅ KV_SESSIONS_ID             KV sessions namespace UUID
#   ✅ KV_RATE_LIMIT_ID           KV rate limit namespace UUID
#
#   All KV/R2/Queue IDs: run `npx wrangler {resource} list`
#   to get UUIDs after creating resources in Cloudflare dashboard.
# ============================================================================
